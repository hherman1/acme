#!/bin/bash

START='2026-01-01'
END='2026-06-01'

function loadgh () {
	if [ ! -f "$1.all" ]; then
		GH_HOST=github.rbx.com gh search prs --created=$START..$END --sort created --limit 1000 --json createdAt,title,url,repository ${@:2} > $1.all
		GH_HOST=github.com gh search prs --sort created --limit 1000 --created=$START..$END  --json createdAt,title,url,repository ${@:2} >> $1.all
	fi
	cat $1.all | jq -s 'add' > $1
}

function mdprs() {
	cat $1 | jq -r 'sort_by(.createdAt) | reverse | map("* [\(.repository.nameWithOwner) \(.title)](\(.url))") | .[]'
}

loadgh /tmp/prs --merged --author=jtrokel
# loadgh /tmp/prs --merged --author=@me
mdprs /tmp/prs



# Code reviews
loadgh /tmp/reviews --reviewed-by=@me -- -author:@me
printf '\n\nREVIEWS\n\n'
mdprs /tmp/reviews


COMPARE=(hherman smistrata garywang jsheffield kwong kfan bwu jtian wbousset nazaria)

# Compare PR counts
printf '\n\nPR Counts\n\n'
for p in "${COMPARE[@]}"
do
	loadgh /tmp/prs.$p --merged --author=$p
	echo $p $(cat /tmp/prs.$p | jq 'length') "(-policies:" $(cat /tmp/prs.$p | jq '[.[] | select(.repository.name != "fleet-manager-policies" and .repository.name != "machine-manager-policies")] | length') ")"
done

# Compare review counts
printf '\n\nReview Counts\n\n'
for p in "${COMPARE[@]}"
do
	loadgh /tmp/reviews.$p --reviewed-by=$p -- -author:$p
	echo $p $(cat /tmp/reviews.$p | jq 'length') "(-policies:" $(cat /tmp/reviews.$p | jq '[.[] | select(.repository.name != "fleet-manager-policies" and .repository.name != "machine-manager-policies")] | length') ")"
done
