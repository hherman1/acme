#!/bin/bash

START='2024-07-01'
END='2024-12-31'

if [ ! -f "/tmp/prs.all" ]; then
	GH_HOST=github.rbx.com gh search prs --merged --author=@me --sort created --limit 700 --json createdAt,title,url,repository > /tmp/prs.all
	GH_HOST=github.com gh search prs --merged --author=@me --sort created --limit 700 --json createdAt,title,url,repository >> /tmp/prs.all
fi

cat /tmp/prs.all | jq -s 'add' > /tmp/prs
cat /tmp/prs | jq -r --arg s $START --arg e $END 'map(select(.createdAt | . >= $s and . <= $e)) | sort_by(.createdAt) | reverse | map("* [\(.repository.nameWithOwner) \(.title)](\(.url))") | .[]'


COMPARE=(hherman smistrata garywang jsheffield kwong kfan bwu jtian wbousset nazaria)
for p in "${COMPARE[@]}"
do
	if [ ! -f "/tmp/prs.$p.all" ]; then
		echo downloading $p
		GH_HOST=github.rbx.com gh search prs --merged --author=$p --sort created --limit 700 --json createdAt,title,url,repository > /tmp/prs.$p.all
	fi
	echo $p $(cat /tmp/prs.$p.all | jq --arg s $START --arg e $END 'map(select(.createdAt | . >= $s and . <= $e)) | length')
done